# Example environment variables
# Copy this file to .env.local and fill in values as needed.
# Never commit .env.local or .env — they are gitignored.

# Optional: Web analytics (Vercel Analytics is used by default, no key needed)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# Optional: Form backend / email service
# CONTACT_FORM_ENDPOINT=
# CONTACT_FORM_API_KEY=

# Optional: Third-party SDK keys (only add if you integrate a service)
# NEXT_PUBLIC_SOME_SERVICE_KEY=
